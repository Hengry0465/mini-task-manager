# Database
POSTGRES_DB=taskmanagerdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production

# Backend
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=taskmanagerdb;Username=postgres;Password=changeme_in_production
Jwt__Key=ChangeThisToARandomSecretKeyMinimum32CharsLong!
Jwt__Issuer=TaskManagerApi
Jwt__Audience=TaskManagerClient
Jwt__ExpiryMinutes=60

# Frontend
API_BASE_URL=http://localhost:5000/api